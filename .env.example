# Postgres connection string. Required.
DATABASE_URL=postgres://polyscrape:polyscrape@localhost:5432/polyscrape

# Limitless Exchange API host (default shown; override only if you proxy it).
LIMITLESS_API_HOST=https://api.limitless.exchange

# How often to snapshot price/volume/book for every tracked market (minutes).
SNAPSHOT_INTERVAL_MINUTES=2

# How often to re-scan Limitless for new markets (hours).
DISCOVERY_INTERVAL_HOURS=3

# How often to check due markets for resolution (minutes).
RESOLUTION_CHECK_INTERVAL_MINUTES=20

# Skip markets expiring within this many minutes of discovery. Limitless has a lot
# of 5-/15-minute crypto churn markets that never live long enough to be useful.
# Set to 0 to track literally everything.
MIN_MARKET_MINUTES=30

# Per snapshot cycle, pull the order book (spread/depth/midpoint) for at most this
# many markets, soonest-to-expire first. Price + volume come from the bulk list for
# every market regardless. 0 disables order-book polling.
ORDERBOOK_LIMIT=100

# Process-wide cap on requests/sec to the Limitless API. It sits behind Cloudflare
# and 429s bursts — keep this low.
LIMITLESS_RPS=6

# debug | info | warn | error
LOG_LEVEL=info

# Port for the internal /health endpoint.
HEALTH_PORT=8080

# Max concurrent in-flight requests (also bounded by LIMITLESS_RPS).
HTTP_CONCURRENCY=4
