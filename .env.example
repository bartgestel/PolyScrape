# Postgres connection string. Required.
DATABASE_URL=postgres://polyscrape:polyscrape@localhost:5432/polyscrape

# Limitless Exchange API host (default shown; override only if you proxy it).
LIMITLESS_API_HOST=https://api.limitless.exchange

# How often to snapshot price/volume/book for every tracked market (minutes).
SNAPSHOT_INTERVAL_MINUTES=2

# How often to re-scan Limitless for new markets (hours).
DISCOVERY_INTERVAL_HOURS=3

# How often to check due markets for resolution (minutes).
RESOLUTION_CHECK_INTERVAL_MINUTES=20

# Skip markets expiring within this many minutes of discovery. Limitless has a lot
# of 5-/15-minute crypto churn markets that never live long enough to be useful.
# Set to 0 to track literally everything.
MIN_MARKET_MINUTES=30

# Per snapshot cycle, pull the order book (levels, depth bands) AND the trade tape
# for at most this many markets, soonest-to-expire first. Price + volume + effective
# buy/sell prices come from the bulk list for every market regardless. 0 disables it.
ORDERBOOK_LIMIT=100

# Collect underlying crypto spot (CoinGecko, one batched request per cycle) into
# underlying_prices. Set to false to skip.
UNDERLYING_ENABLED=true

# --- equity underlying (gap 1) -------------------------------------------------
# Tiingo IEX feed for EQUITY-oracle markets (AAPL, NVDA, SPY, …). Free key from
# tiingo.com (email signup). Leave blank to skip equity underlying entirely.
TIINGO_API_KEY=
# A Tiingo quote is only stored if its trade timestamp is fresher than this, so
# nothing is written while US markets are closed (nights / weekends / holidays).
EQUITY_STALE_MINUTES=20

# --- slippage estimate (gap 2) ----------------------------------------------
# Representative market-order sizes (USDC, comma-separated) for the per-snapshot
# slippage estimate written to snapshots.slippage. Only computed where book data
# exists (the ORDERBOOK_LIMIT polled subset).
SLIPPAGE_ORDER_SIZES_USDC=50,250,1000

# --- Base gas tracking (gap 3) --------------------------------------------------
# One eth_gasPrice call per snapshot cycle → gas_prices(ts, gas_price_gwei).
# Informational only (for later cost-adjusted backtesting); nothing reads it yet.
GAS_TRACKING_ENABLED=true
BASE_RPC_URL=https://mainnet.base.org

# --- retention / downsampling (gap 4) ----------------------------------------
# How often the decimation sweep runs (hours).
RETENTION_INTERVAL_HOURS=24
# Keep full 2-minute resolution until a market has been resolved this many days.
RETENTION_FULL_DAYS=7
# After that, thin a market's snapshots to one collection cycle per this many
# minutes. Must stay well under getCalibration's ±3h match tolerance.
RETENTION_COARSE_MINUTES=15
# >0: also hard-delete ALL snapshots for markets resolved longer ago than this.
# 0 = never hard-delete (default).
RETENTION_DROP_DAYS=0

# Process-wide cap on requests/sec to the Limitless API. It sits behind Cloudflare
# and 429s bursts — keep this low.
LIMITLESS_RPS=6

# debug | info | warn | error
LOG_LEVEL=info

# Port for the internal /health endpoint.
HEALTH_PORT=8080

# Max concurrent in-flight requests (also bounded by LIMITLESS_RPS).
HTTP_CONCURRENCY=4
