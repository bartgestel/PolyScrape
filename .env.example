# Postgres connection string. Required.
DATABASE_URL=postgres://polyscrape:polyscrape@localhost:5432/polyscrape

# Polymarket API hosts (defaults shown; override only if you proxy them).
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com

# How often to snapshot price/volume/book for every tracked market (minutes).
SNAPSHOT_INTERVAL_MINUTES=2

# How often to re-scan Polymarket for new sports/weather markets (hours).
DISCOVERY_INTERVAL_HOURS=3

# How often to check whether past-due markets have resolved (minutes).
RESOLUTION_CHECK_INTERVAL_MINUTES=20

# debug | info | warn | error
LOG_LEVEL=info

# Port for the internal /health endpoint.
HEALTH_PORT=8080

# Max concurrent outbound API calls per job. Raise if a snapshot cycle can't
# finish within SNAPSHOT_INTERVAL_MINUTES at your tracked-market count.
HTTP_CONCURRENCY=8
