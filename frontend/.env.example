# Same Postgres the collector writes to. The frontend only issues read-only queries
# (the connection is pinned to default_transaction_read_only=on).
DATABASE_URL=postgres://polyscrape:polyscrape@localhost:5432/polyscrape

# Host port for direct access (compose maps it to container port 3000).
# Behind Nginx Proxy Manager on proxy-net you can ignore this.
FRONTEND_PORT=8081
